{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "redstar071-dev",
  "compatibility_date": "2026-06-30",
  "compatibility_flags": ["nodejs_compat"],
  // Built by `nuxt build` with Nitro's cloudflare-module preset.
  "main": ".output/server/index.mjs",
  // Pages are prerendered and served straight from the assets; only the live
  // routes run the Worker, so nothing else ever needs Nuxt Content's database.
  "assets": {
    "directory": ".output/public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/readme/*"]
  },
  // `wrangler preview` (the Workers Builds deploy step for branches) refuses to run without this
  // block. The Worker reads no variables at runtime, so there is nothing to put in it: the
  // Bluesky app password is only needed at build time and must never be written here.
  "previews": {
    "vars": {}
  }
}
