{
  "name": "nuxt-ui-template-portfolio",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare && simple-git-hooks",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "nuxt typecheck",
    "generate": "nuxt generate",
    "deploy": "nuxt generate && wrangler deploy",
    "atproto:publish": "node --env-file-if-exists=.env scripts/publish-standard-site.ts",
    "atproto:projects": "node --env-file-if-exists=.env scripts/publish-projects.ts",
    "atproto:lexicons": "node --env-file-if-exists=.env scripts/publish-lexicons.ts"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.134",
    "@iconify-json/material-symbols": "^1.2.92",
    "@iconify-json/simple-icons": "^1.2.96",
    "@nuxt/content": "^3.16.0",
    "@nuxt/fonts": "^0.13.0",
    "@nuxt/image": "^2.1.0",
    "@nuxt/ui": "^4.11.1",
    "@takumi-rs/core": "^2.14.0",
    "@vueuse/nuxt": "^14.4.0",
    "discord-component-embed": "^0.2.2",
    "motion-v": "^2.4.4",
    "nuxt": "^4.5.2",
    "nuxt-og-image": "^6.8.0",
    "tailwindcss": "^4.3.3",
    "ufo": "^1.6.4"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^6.1.0",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@nuxt/eslint": "^1.17.0",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9.38.0",
    "eslint-plugin-package-json": "^0.59.0",
    "eslint-plugin-vuejs-accessibility": "^2.4.1",
    "nano-staged": "^1.0.2",
    "simple-git-hooks": "^2.14.0",
    "taze": "^19.8.1",
    "typescript": "^5.9.3",
    "vue-tsc": "^3.3.11",
    "wrangler": "^4.130.0",
    "yaml": "^2.9.1"
  },
  "packageManager": "pnpm@12.5.1",
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec nano-staged",
    "commit-msg": "pnpm commitlint --edit $1"
  },
  "nano-staged": {
    "*.{js,mjs,cjs,ts,vue,json,jsonc,yml,yaml,md}": "eslint --fix"
  }
}
