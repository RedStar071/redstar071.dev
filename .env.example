# Public URL, used for OG Image when running nuxt generate
NUXT_PUBLIC_SITE_URL=

# Create one at https://www.last.fm/api/account/create and keep it server-side.
NUXT_LASTFM_API_KEY=
# Optional: defaults to redstar071.
NUXT_PUBLIC_LASTFM_USERNAME=redstar071

# README cards under /readme/*. On the Worker, set these with `wrangler secret put <NAME>`.
# A fine-grained token with no extra permissions: it only reads public data, for /readme/stats.svg and /readme/languages.svg.
NUXT_GITHUB_TOKEN=
# Optional: defaults to RedStar071.
NUXT_PUBLIC_GITHUB_USERNAME=RedStar071
# Optional: /readme/listening.svg reads Spotify when these are set, Last.fm otherwise.
# Create an app at https://developer.spotify.com/dashboard, then `pnpm spotify:token` prints the refresh token.
NUXT_SPOTIFY_CLIENT_ID=
NUXT_SPOTIFY_CLIENT_SECRET=
NUXT_SPOTIFY_REFRESH_TOKEN=

# App password from Bluesky settings, for `pnpm run deploy` (which syncs the records) and `pnpm lex:publish`
ATPROTO_APP_PASSWORD=
